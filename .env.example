# Copy to .env and fill in. SQLite works out of the box for local dev.
DATABASE_URL="file:./dev.db"

# Required: signs session cookies. Use a long random string in production.
AUTH_SECRET="change-me"

# Optional: Stripe billing. Leave blank to run billing in demo mode.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PRICE_PRO=""
NEXT_PUBLIC_STRIPE_PRICE_BUSINESS=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: email (verification + password reset). Blank = dev mode (logs link).
RESEND_API_KEY=""
EMAIL_FROM="Kringle <hello@kriskringlemail.com>"

# Optional: AI note writing. Blank = themed template fallback.
ANTHROPIC_API_KEY=""

# Optional: handwriting / auto-pen provider. handwrytten | axidraw | manual
HANDWRITING_PROVIDER="manual"
HANDWRYTTEN_API_KEY=""
HANDWRYTTEN_API_URL="https://api.handwrytten.com/v1"
HANDWRYTTEN_CARD_ID=""
HANDWRYTTEN_FONT_ID=""

# Protects the cron endpoint (/api/cron/run). Set in your scheduler too.
CRON_SECRET=""
